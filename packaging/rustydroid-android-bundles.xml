<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.android.xapk">
    <comment>Android XAPK Application Bundle</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.xapk"/>
  </mime-type>
  <mime-type type="application/vnd.android.apks">
    <comment>Android Split APK Bundle</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.apks"/>
  </mime-type>
  <mime-type type="application/vnd.android.apkm">
    <comment>APKMirror Split APK Bundle</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.apkm"/>
  </mime-type>
</mime-info>
